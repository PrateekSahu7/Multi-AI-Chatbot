# Copy to .env and fill in the keys you have. Keys stay on the server (SRS BR-07).
# Agents using the "mock" provider work without any key.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional settings
MAX_PROMPT_CHARS=4000
PROVIDER_TIMEOUT_SECONDS=30

# Public site: make visitors bring their own keys (ignores the keys above for real providers)
REQUIRE_USER_KEYS=false
